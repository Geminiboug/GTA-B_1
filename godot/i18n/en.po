#: scripts/dialogues.gd:12
msgid "Bonjour {appel} !"
msgstr "Hello {appel}!"

#: scripts/dialogues.gd:12
msgid "A fon ganji à ?"
msgstr ""

#: scripts/dialogues.gd:12
msgid "Bonne journée {appel}."
msgstr "Have a good day {appel}."

#: scripts/dialogues.gd:12
msgid "Bonjour, ça va un peu ?"
msgstr "Hello, how's it going?"

#: scripts/dialogues.gd:13
msgid "Bonsoir {appel} !"
msgstr "Good evening {appel}!"

#: scripts/dialogues.gd:13
msgid "Bonsoir, ça va ?"
msgstr "Good evening, how are you?"

#: scripts/dialogues.gd:13
msgid "On dit quoi {appel} ?"
msgstr "What's up {appel}?"

#: scripts/dialogues.gd:13
msgid "Bonne arrivée !"
msgstr "Welcome back!"

#: scripts/dialogues.gd:13
msgid "Mi kwabo !"
msgstr ""

#: scripts/dialogues.gd:14
msgid "{appel}, viens acheter !"
msgstr "{appel}, come and buy!"

#: scripts/dialogues.gd:14
msgid "Eau glacée ! Pure water !"
msgstr "Ice-cold water! Pure water!"

#: scripts/dialogues.gd:14
msgid "C'est frais, viens voir !"
msgstr "It's fresh, come and see!"

#: scripts/dialogues.gd:14
msgid "Ma copine, approche !"
msgstr "My girl, come closer!"

#: scripts/dialogues.gd:15
msgid "Je te fais un bon prix !"
msgstr "I'll give you a good price!"

#: scripts/dialogues.gd:15
msgid "Arachides grillées !"
msgstr "Roasted peanuts!"

#: scripts/dialogues.gd:15
msgid "Ananas bien sucré !"
msgstr "Sweet pineapple!"

#: scripts/dialogues.gd:15
msgid "Pain chaud, pain chaud !"
msgstr "Hot bread, hot bread!"

#: scripts/dialogues.gd:16
msgid "Zem ? On va où ?"
msgstr "Zem? Where to?"

#: scripts/dialogues.gd:16
msgid "{appel}, je te dépose ?"
msgstr "{appel}, need a ride?"

#: scripts/dialogues.gd:16
msgid "Montez, je connais la route !"
msgstr "Hop on, I know the way!"

#: scripts/dialogues.gd:17
msgid "Eh ! Tu ne vois pas devant toi ?"
msgstr "Hey! Can't you see where you're going?"

#: scripts/dialogues.gd:17
msgid "Doucement {appel} !"
msgstr "Easy {appel}!"

#: scripts/dialogues.gd:17
msgid "Pardon hein !"
msgstr "Sorry eh!"

#: scripts/dialogues.gd:17
msgid "Tu es aveugle ou quoi ?"
msgstr "Are you blind or what?"

#: scripts/dialogues.gd:18 scripts/dialogues.gd:28
msgid "Eh Dieu !"
msgstr "Oh God!"

#: scripts/dialogues.gd:18
msgid "Regarde où tu marches !"
msgstr "Watch where you're walking!"

#: scripts/dialogues.gd:18
msgid "Ça va pas non ?"
msgstr "Are you crazy?"

#: scripts/dialogues.gd:19
msgid "Mes affaires ! Tu vas payer !"
msgstr "My things! You're going to pay!"

#: scripts/dialogues.gd:19
msgid "Eh ! Ma marchandise !"
msgstr "Hey! My goods!"

#: scripts/dialogues.gd:19
msgid "Regarde ce que tu as fait !"
msgstr "Look what you've done!"

#: scripts/dialogues.gd:20
msgid "Tu me frappes pourquoi ?!"
msgstr "Why are you hitting me?!"

#: scripts/dialogues.gd:20
msgid "Eh ! Tu es malade ?"
msgstr "Hey! Are you sick?"

#: scripts/dialogues.gd:20 scripts/dialogues.gd:28
msgid "Au secours !"
msgstr "Help!"

#: scripts/dialogues.gd:20
msgid "Laisse-moi tranquille !"
msgstr "Leave me alone!"

#: scripts/dialogues.gd:21
msgid "Eh ! Laisse-le !"
msgstr "Hey! Leave him alone!"

#: scripts/dialogues.gd:21
msgid "Qu'est-ce qui ne va pas chez toi ?"
msgstr "What's wrong with you?"

#: scripts/dialogues.gd:21
msgid "Séparez-les !"
msgstr "Break them up!"

#: scripts/dialogues.gd:21 scripts/dialogues.gd:23
msgid "Eh Seigneur !"
msgstr "Oh Lord!"

#: scripts/dialogues.gd:22
msgid "Ahi ! Ma jambe !"
msgstr "Ahi! My leg!"

#: scripts/dialogues.gd:22
msgid "Tu es fou ? Tu ne sais pas conduire ?"
msgstr "Are you mad? Can't you drive?"

#: scripts/dialogues.gd:22
msgid "Il faut payer mes soins !"
msgstr "You have to pay for my care!"

#: scripts/dialogues.gd:22
msgid "Eh Dieu, j'ai mal !"
msgstr "Oh God, it hurts!"

#: scripts/dialogues.gd:23
msgid "Il a renversé quelqu'un !"
msgstr "He ran someone over!"

#: scripts/dialogues.gd:23
msgid "Arrêtez-le !"
msgstr "Stop him!"

#: scripts/dialogues.gd:23
msgid "Appelez quelqu'un !"
msgstr "Call someone!"

#: scripts/dialogues.gd:23
msgid "Il faut payer !"
msgstr "You have to pay!"

#: scripts/dialogues.gd:24
msgid "Eh ! Tu veux me tuer ?"
msgstr "Hey! You want to kill me?"

#: scripts/dialogues.gd:24
msgid "Doucement chauffeur !"
msgstr "Easy, driver!"

#: scripts/dialogues.gd:24
msgid "Tu roules comme un fou !"
msgstr "You drive like a madman!"

#: scripts/dialogues.gd:24
msgid "Eh ! Freine !"
msgstr "Hey! Brake!"

#: scripts/dialogues.gd:25
msgid "Mon véhicule ! Voleur !"
msgstr "My vehicle! Thief!"

#: scripts/dialogues.gd:25
msgid "Au voleur ! Attrapez-le !"
msgstr "Stop, thief! Catch him!"

#: scripts/dialogues.gd:25
msgid "Descends de là ! C'est à moi !"
msgstr "Get off! That's mine!"

#: scripts/dialogues.gd:25
msgid "Eh ! On vole ma voiture !"
msgstr "Hey! Someone's stealing my car!"

#: scripts/dialogues.gd:26
msgid "Avance !"
msgstr "Move!"

#: scripts/dialogues.gd:26
msgid "Eh, bouge de là !"
msgstr "Hey, get out of the way!"

#: scripts/dialogues.gd:26
msgid "Tu attends quoi ?"
msgstr "What are you waiting for?"

#: scripts/dialogues.gd:26
msgid "Doucement, on va où ?"
msgstr "Easy, where are we going?"

#: scripts/dialogues.gd:27
msgid "Eh ! Tu es fou ?"
msgstr "Hey! Are you crazy?"

#: scripts/dialogues.gd:27
msgid "Tu as vu ce que tu as fait ?"
msgstr "Did you see what you did?"

#: scripts/dialogues.gd:27
msgid "Il faut payer la réparation !"
msgstr "You have to pay for the repairs!"

#: scripts/dialogues.gd:27
msgid "Tu ne sais pas conduire ?"
msgstr "Can't you drive?"

#: scripts/dialogues.gd:28
msgid "Ahi ! Courez !"
msgstr "Ahi! Run!"

#: scripts/dialogues.gd:29
msgid "Eh ! On ne se bat pas ici !"
msgstr "Hey! No fighting in here!"

#: scripts/dialogues.gd:29
msgid "Sortez du magasin !"
msgstr "Get out of the shop!"

#: scripts/dialogues.gd:29
msgid "Sécurité ! Arrêtez ça !"
msgstr "Security! Stop that!"

#: scripts/dialogues.gd:29
msgid "Doucement, monsieur !"
msgstr "Easy, sir!"

#: scripts/dialogues.gd:30
msgid "Pardon {appel}."
msgstr "Sorry {appel}."

#: scripts/dialogues.gd:30
msgid "Excusez-moi."
msgstr "Excuse me."

#: scripts/dialogues.gd:30
msgid "Eh, doucement !"
msgstr "Hey, easy!"

#: scripts/dialogues.gd:31
msgid "Viens ! Tu vas voir !"
msgstr "Come on! You'll see!"

#: scripts/dialogues.gd:31
msgid "Tu me cherches, {appel} ?"
msgstr "Looking for trouble, {appel}?"

#: scripts/dialogues.gd:31
msgid "On va régler ça ici !"
msgstr "We'll settle this right here!"

#: scripts/dialogues.gd:31
msgid "Approche si tu es fort !"
msgstr "Come closer if you're tough!"

#: scripts/dialogues.gd:32
msgid "Allô, la police ? On m'agresse !"
msgstr "Hello, police? I'm being attacked!"

#: scripts/dialogues.gd:32
msgid "Venez vite, il y a un fou qui frappe les gens !"
msgstr "Come quick, there's a madman hitting people!"

#: scripts/dialogues.gd:32
msgid "Allô ? Il m'a frappé, venez !"
msgstr "Hello? He hit me, come!"

#: scripts/dialogues.gd:33
msgid "Ahi... ma tête..."
msgstr "Ahi... my head..."

#: scripts/dialogues.gd:33
msgid "Pitié, pitié !"
msgstr "Mercy, mercy!"

#: scripts/dialogues.gd:33
msgid "Arrête, arrête !"
msgstr "Stop, stop!"

#: scripts/dialogues.gd:41
msgid "{appel}"
msgstr ""

#: scripts/histoire.gd:162
msgid "Bonne arrivée"
msgstr "Welcome back"

#: scripts/histoire.gd:163 scripts/histoire.gd:193
msgid "Parle à tante Mireille"
msgstr "Talk to Aunt Mireille"

#: scripts/histoire.gd:164
msgid "Ah, %s ! Bonne arrivée à la maison !"
msgstr "Ah, %s! Welcome home!"

#: scripts/histoire.gd:164
msgid "mon fils"
msgstr "my son"

#: scripts/histoire.gd:164
msgid "ma fille"
msgstr "my daughter"

#: scripts/histoire.gd:165
msgid "Va m'acheter du pain chez la vendeuse, au bout de la rue. Tiens, prends de quoi payer."
msgstr "Go buy me some bread from the seller at the end of the street. Here, take something to pay with."

#: scripts/histoire.gd:166
msgid "J'y vais, tantie."
msgstr "I'm going, auntie."

#: scripts/histoire.gd:167
msgid "Suis la flèche jaune jusqu'à l'étal, puis T pour acheter du pain"
msgstr "Follow the yellow arrow to the stall, then T to buy bread"

#: scripts/histoire.gd:168
msgid "Rapporte le pain à tante Mireille"
msgstr "Bring the bread back to Aunt Mireille"

#: scripts/histoire.gd:169
msgid "Donne le pain (T)"
msgstr "Give the bread (T)"

#: scripts/histoire.gd:170
msgid "Merci ! Ton père aurait été fier de te voir revenu."
msgstr "Thank you! Your father would have been proud to see you back."

#: scripts/histoire.gd:171
msgid "Son vieux zem est devant la maison. Il roule encore, prends-le."
msgstr "His old zem is in front of the house. It still runs, take it."

#: scripts/histoire.gd:172
msgid "Tiens, 5 000 francs : va me chercher un sac de riz à l'Ararat."
msgstr "Here, 5,000 francs: go get me a bag of rice at the Ararat."

#: scripts/histoire.gd:173
msgid "Le zem de papa"
msgstr "Dad's zem"

#: scripts/histoire.gd:174
msgid "Monte sur le zem de ton père (E)"
msgstr "Get on your father's zem (E)"

#: scripts/histoire.gd:175
msgid "Achète un sac de riz à l'Ararat Hypermarket"
msgstr "Buy a bag of rice at the Ararat Hypermarket"

#: scripts/histoire.gd:176
msgid "Rapporte le riz à la maison"
msgstr "Bring the rice home"

#: scripts/histoire.gd:177
msgid "Donne le riz (T)"
msgstr "Give the rice (T)"

#: scripts/histoire.gd:178
msgid "Bien ! Va voir Vieux Codjo au maquis du coin, il cherche quelqu'un pour des livraisons."
msgstr "Good! Go see Old Codjo at the corner maquis, he's looking for someone to make deliveries."

#: scripts/histoire.gd:179
msgid "Livraison en zem"
msgstr "Zem delivery"

#: scripts/histoire.gd:180 scripts/histoire.gd:187
msgid "Parle à Vieux Codjo"
msgstr "Talk to Old Codjo"

#: scripts/histoire.gd:181
msgid "C'est toi l'enfant de Basile ? Ton père réparait tout ce qui roule et tout ce qui vole."
msgstr "You're Basile's kid? Your father fixed anything that rolled and anything that flew."

#: scripts/histoire.gd:182
msgid "Tiens ce colis. Livre-le à l'étal là-bas, en moins de trois minutes. Le client n'attend pas !"
msgstr "Take this parcel. Deliver it to that stall over there, in under three minutes. The customer won't wait!"

#: scripts/histoire.gd:183 scripts/histoire.gd:184 scripts/histoire.gd:185 scripts/histoire.gd:391
msgid "Colis"
msgstr "Parcel"

#: scripts/histoire.gd:184
msgid "Livre le colis"
msgstr "Deliver the parcel"

#: scripts/histoire.gd:186
msgid "Course client"
msgstr "Customer ride"

#: scripts/histoire.gd:188
msgid "Un voyageur attend devant l'aérogare. Il veut aller à Sweet Dream Beach. Fais vite !"
msgstr "A traveller is waiting outside the terminal. He wants to go to Sweet Dream Beach. Hurry!"

#: scripts/histoire.gd:189
msgid "Va chercher le client devant l'aérogare (en zem)"
msgstr "Pick up the customer outside the terminal (by zem)"

#: scripts/histoire.gd:190
msgid "Dépose le client à Sweet Dream Beach"
msgstr "Drop the customer at Sweet Dream Beach"

#: scripts/histoire.gd:191
msgid "Merci, %s ! Bonne route."
msgstr "Thanks, %s! Safe travels."

#: scripts/histoire.gd:192
msgid "Au marché"
msgstr "At the market"

#: scripts/histoire.gd:194
msgid "Il me faut de l'huile et une boîte de tomate pour la sauce. Va à l'Ararat."
msgstr "I need oil and a can of tomato for the sauce. Go to the Ararat."

#: scripts/histoire.gd:195
msgid "Voilà 2 000 francs pour les courses."
msgstr "Here's 2,000 francs for the shopping."

#: scripts/histoire.gd:196
msgid "Achète de l'huile"
msgstr "Buy oil"

#: scripts/histoire.gd:197
msgid "Achète une boîte de tomate"
msgstr "Buy a can of tomato"

#: scripts/histoire.gd:198
msgid "Rentre à la maison"
msgstr "Go back home"

#: scripts/histoire.gd:199 scripts/histoire.gd:230
msgid "Donne les courses (T)"
msgstr "Give the shopping (T)"

#: scripts/histoire.gd:200
msgid "Merci. Écoute... j'ai gardé quelque chose de ton père."
msgstr "Thank you. Listen... I kept something of your father's."

#: scripts/histoire.gd:201
msgid "Son carnet. Il a écrit un mot la veille du dernier vol : « Épave, cabine, rangée 12 »."
msgstr "His notebook. He wrote something the night before the last flight: \"Wreck, cabin, row 12\"."

#: scripts/histoire.gd:202
msgid "L'épave de la plage ? Papa y était ?"
msgstr "The wreck on the beach? Dad was there?"

#: scripts/histoire.gd:203
msgid "Je ne sais pas. Mais sois prudent. La nuit, la police patrouille sur la plage."
msgstr "I don't know. But be careful. At night, the police patrol the beach."

#: scripts/histoire.gd:203
msgid "Carnet de Basile"
msgstr "Basile's notebook"

#: scripts/histoire.gd:204 scripts/hud_carte.gd:39 scripts/taxi.gd:17
msgid "L'Épave Volante"
msgstr "The Flying Wreck"

#: scripts/histoire.gd:205
msgid "Le soir tombe..."
msgstr "Evening falls..."

#: scripts/histoire.gd:206
msgid "Va à l'épave, sur la plage"
msgstr "Go to the wreck, on the beach"

#: scripts/histoire.gd:207
msgid "Fouille la cabine, rangée 12 (T)"
msgstr "Search the cabin, row 12 (T)"

#: scripts/histoire.gd:208
msgid "Une plaque d'avion arrachée... et un nom gravé : « Cdt Hounkpè »."
msgstr "A plate torn from a plane... and an engraved name: \"Cdt Hounkpè\"."

#: scripts/histoire.gd:209
msgid "Plaque du cargo"
msgstr "Cargo plate"

#: scripts/histoire.gd:210
msgid "Une patrouille ! Échappe à la police"
msgstr "A patrol! Escape the police"

#: scripts/histoire.gd:211
msgid "Le Commandant"
msgstr "The Commander"

#: scripts/histoire.gd:212
msgid "Parle au Commandant Hounkpè"
msgstr "Talk to Commander Hounkpè"

#: scripts/histoire.gd:213
